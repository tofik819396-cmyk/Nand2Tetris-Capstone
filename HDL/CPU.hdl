// CPU.hdl
CHIP CPU {
    IN  inM[16],         // Memory value input (M = RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current program
    OUT outM[16],        // Write value to Memory
        writeM,          // Write to Memory?
        addressM[15],    // Address in Memory (for M)
        pc[15];          // address of next instruction

    PARTS:
    // Instruction decoding
    // instruction[15] == 0: A-instruction, 1: C-instruction
    Not(in=instruction[15], out=isA);
    Not(in=isA, out=isC);
    
    // ALU Destination & Register Controls
    And(a=isC, b=instruction[5], out=ALUtoA);
    Mux16(a=instruction, b=outALU, sel=ALUtoA, out=inA);
    
    Or(a=isA, b=ALUtoA, out=loadA);
    ARegister(in=inA, load=loadA, out=outA, out[0..14]=addressM);

    And(a=isC, b=instruction[4], out=loadD);
    DRegister(in=outALU, load=loadD, out=outD);

    // ALU operation
    Mux16(a=outA, b=inM, sel=instruction[12], out=AMout);
    ALU(x=outD, y=AMout, zx=instruction[11], nx=instruction[10], 
        zy=instruction[9], ny=instruction[8], f=instruction[7], 
        no=instruction[6], out=outALU, out=outM, zr=zr, ng=ng);

    // Memory write control
    And(a=isC, b=instruction[3], out=writeM);

    // Program Counter Logic (Jump Condition Evaluation)
    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);
    And(a=notZr, b=notNg, out=pos);

    And(a=instruction[0], b=pos, out=j3);   // JGT
    And(a=instruction[1], b=zr, out=j2);    // JEQ
    And(a=instruction[2], b=ng, out=j1);    // JLT

    Or(a=j1, b=j2, out=j12);
    Or(a=j12, b=j3, out=jumpCond);
    And(a=isC, b=jumpCond, out=pcLoad);

    PC(in=outA, load=pcLoad, inc=true, reset=reset, out[0..14]=pc);
}